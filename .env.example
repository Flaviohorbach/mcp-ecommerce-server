# Only the demo panel needs this. The MCP server itself calls no model.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. A JSON object of sha256(token) -> principal, which replaces the public demo tokens.
# Example: {"<sha256 of the token>":{"clientId":"my-app","scopes":["catalog:read"]}}
MCP_TOKENS=
